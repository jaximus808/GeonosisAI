# Copy to .env and fill in. .env is gitignored.
# Check what's set without printing values:  ./scripts/check-env.sh

# ---------- REQUIRED for overnight ----------
# Planner, reviewer, QA agents (Claude API)
ANTHROPIC_API_KEY=
# Factory Droid SDK (long-running agents)
FACTORY_API_KEY=
# Factory droid mode (TDM-30): local (default tonight; droid-sdk against this checkout) | cloud (Sessions API)
FACTORY_MODE=
# Cloud only: Factory Environment to create Droid Computers from (blank = 173ec531-f4f8-46e0-b246-6594c9590ea5)
FACTORY_ENVIRONMENT_ID=
# Cloud only, optional: reuse this Droid Computer instead of creating one
FACTORY_COMPUTER_ID=
# Optional: droid model (blank = gpt-5.4-mini) and reasoning effort (blank = low)
FACTORY_MODEL=
FACTORY_REASONING=
# Stripe TEST mode only (sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Hugging Face: LeRobot datasets, model downloads
HF_TOKEN=

# ---------- Modal ----------
# Local CLI is already logged in (~/.modal.toml). These are only needed for
# the deployed backend on Fly to launch Modal jobs.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---------- Optional ----------
# Training curves (openpi logs to W&B by default; leave blank to disable)
WANDB_API_KEY=
# Only if we use Stripe webhooks (from `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# Fly deploy (later)
FLY_API_TOKEN=
# Public tunnel for phones / Claude connector (blank = cloudflared quick tunnel)
NGROK_AUTHTOKEN=
# SpacetimeDB Maincloud (blank = local standalone server)
SPACETIME_TOKEN=

# ---------- Non-secret config ----------
SPACETIME_HOST=http://localhost:3000
SPACETIME_DB_NAME=robot-deploy-factory
JETSON_HOST=
JETSON_USER=
# TDM-44 Jetson (scripts/jetson/jetson.sh): ssh port, robot name, and the orchestrator URL as the Jetson
# sees it (laptop LAN IP or tunnel; blank = the Jetson's own localhost, which breaks uploads)
JETSON_PORT=
JETSON_ROBOT_ID=
JETSON_ORCHESTRATOR_URL=
# robot_client SpacetimeDB identity for the Jetson (scripts/jetson/jetson.sh mint-identity --yes writes it)
ROBOT_CLIENT_SPACETIME_TOKEN=


# ---------- Object storage (S3-compatible, episode media) ----------
# Loaded only by code that touches storage (StorageSettings / storageEnv).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- Service wiring (blank = default in code) ----------
# How the robot client, Factory and the web/MCP apps reach the orchestrator (default http://localhost:8000)
ORCHESTRATOR_URL=
# Robot this robot-client process drives (default yam-1)
ROBOT_ID=
# WebSocket port the Jetson robot-client listens on (default 8765)
JETSON_WS_PORT=

# ---------- Episode media store (TDM-4; see docs/decisions.md) ----------
# Backend: modal (default, Modal Volume behind services/media-store/) or s3 (Tigris/MinIO).
RDF_MEDIA_BACKEND=modal
# Public URL of the deployed services/media-store app (modal deploy prints it)
RDF_MEDIA_STORE_URL=https://jaxonp808--rdf-media.modal.run
# HMAC key shared with the Modal Secret `rdf-media-store`. Generate with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
RDF_MEDIA_SIGNING_KEY=
# Only for RDF_MEDIA_BACKEND=s3 (Tigris on Fly / local MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- Policy endpoint (TDM-37 / S-05b) ----------
# Base pi0.5 on Modal (app rdf-s05b-policy). POST {url}/infer or websocket {url}/ws.
# Scales to zero; warm it first: uv run --with modal python spikes/tdm-37-latency/warm.py up
POLICY_ENDPOINT_URL=https://jaxonp808--rdf-s05b-policy-policy-web.us-west.modal.run

# ---------- Policy server (TDM-41, production) ----------
# rdf-training app, class Policy: base pi0.5 + fine-tuned checkpoints, hot-swapped by URI.
# GET /health (public), POST /infer, websocket /ws, POST /policy/activate (Bearer POLICY_SERVER_TOKEN).
# Scales to zero: `make policy-up` before a robot session, `make policy-down` after.
POLICY_SERVER_URL=https://jaxonp808--rdf-training-policy-web.us-west.modal.run
# Shared bearer token; also synced into Modal Secret rdf-training by `make modal-secrets`.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POLICY_SERVER_TOKEN=

# ---------- Claude connector (apps/mcp, TDM-80) ----------
# Bearer token Claude / the MCP Inspector sends to POST /mcp (generate: openssl rand -hex 32)
MCP_TOKEN=
# Largest single approve_spend call through the connector, in cents (default 50000 = $500)
MCP_MAX_SPEND_CENTS=
# TDM-81 OAuth for claude.ai (docs/connector.md). The consent page reuses RDF_OPERATOR_PASSCODE (below).
# Public origin users paste into claude.ai, e.g. https://rdf-mcp.fly.dev (blank = from the Host header)
MCP_PUBLIC_URL=
# Optional HMAC key for OAuth clients/codes/tokens (blank = derived from MCP_TOKEN); rotating it signs everyone out
MCP_OAUTH_SECRET=
# Optional: allowed https redirect hosts (default claude.ai,claude.com; loopback always allowed)
MCP_OAUTH_REDIRECT_HOSTS=
# Optional: hosts whose Client ID Metadata Documents are accepted (default claude.ai,claude.com; "-" = off)
MCP_OAUTH_CIMD_HOSTS=
# Optional: OAuth access-token lifetime in seconds (default 3600)
MCP_OAUTH_ACCESS_TTL_S=

# ---------- Policy rollout (TDM-50) ----------
# spike (default: POLICY_ENDPOINT_URL, no auth) | production (TDM-41: POLICY_SERVER_URL + POLICY_SERVER_TOKEN)
POLICY_BACKEND=

# ---------- Camera stream (TDM-55) ----------
# HMAC key shared by the orchestrator (mints /stream/token) and the Jetson stream server (generate: openssl rand -hex 32)
RDF_STREAM_TOKEN_SECRET=
# Optional: override the public stream URL the orchestrator hands out (else robot.camera_config_json.stream.url)
RDF_STREAM_URL=

# ---------- Robot page commands (TDM-78) ----------
# Shared key the web server adds to operator commands it forwards to the orchestrator
# (POST /robots/{id}/commands). Unset = every motion command from the page answers 503; the soft
# e-stop never needs it. Generate: uv run python spikes/tdm-78-robot-page/setup_web_auth.py operator-key
RDF_OPERATOR_KEY=
# `web` service identity token for the soft e-stop's direct path (web server -> SpacetimeDB). Unset =
# the e-stop goes through the orchestrator. Mint (writes to the DB): setup_web_auth.py mint-web-identity --yes
RDF_WEB_SPACETIME_TOKEN=

# ---------- Operator login (web app) ----------
# Passcode for /ops/login. Its 12 h session cookie is required for robot motion commands, ticket
# creation, run-settings / budget changes, report save and control-lease revoke. Unset = those
# routes answer 503 (fail closed). The soft e-stop never needs it. Set before exposing the site.
RDF_OPERATOR_PASSCODE=

# ---------- Web push paging (TDM-65) ----------
# VAPID key pair (base64url: public = uncompressed P-256 point, private = raw 32-byte scalar).
# Generate once, locally; the orchestrator signs pushes, the browser gets the public key from GET /push/config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach (mailto: or https:)
VAPID_SUBJECT=
# Optional: where the orchestrator keeps push subscriptions (sqlite; default ~/.local/state/rdf/tdm65_push.sqlite3)
RDF_PUSH_STORE=
# Optional: public base URL of the web app for notification deep links (default: relative /marketplace?task=N)
RDF_WEB_PUBLIC_URL=
# TDM-62 reset tasks: re-page an unclaimed reset after this many seconds (level 1), operator
# escalation at 2x (level 2). 0 disables. Not a secret.
RDF_RESET_ESCALATE_S=

# ---------- LLM backend (rdf_common.llm; every Claude call: ticket parse, diagnose, planner, reviewer, LLM QA) ----------
# api | droid | claude_code. Unset = api.
#   api          the Anthropic SDK (claude-opus-5-5, structured outputs, vision, server-side fallbacks). The real demo / E2E.
#   droid        Factory credits via the local droid CLI (~/.local/bin/droid exec, read-only, Read tool only). Testing compute.
#   claude_code  the local Claude Code harness (~/.local/bin/claude -p, no tools; bills your Claude Code login). Heavy local testing.
# Switch at runtime (no restart) from /ops/settings or PUT /admin/llm; the choice persists in RDF_LLM_STATE_FILE.
# Cloud / production (RDF_DEPLOY_ENV=production|cloud, or FLY_APP_NAME set) is locked to api: startup fails otherwise.
RDF_LLM_BACKEND=
# Model for the droid backend (default claude-opus-5-5; `droid exec --help` lists models)
RDF_LLM_DROID_MODEL=
# Model for the claude_code backend (default opus; an alias or a full model id)
RDF_LLM_CLAUDE_CODE_MODEL=
# Per-call timeout for the CLI backends in seconds (default 300); the API keeps the SDK's own timeout
RDF_LLM_CLI_TIMEOUT_S=
# Optional: where the runtime backend choice is kept (default ~/.local/state/rdf/llm_backend.json)
RDF_LLM_STATE_FILE=
# Optional: write each llm.call record to event_log too (default 1; 0 = log line only)
RDF_LLM_CALL_EVENTS=
# Deploy environment: local (default) | production | cloud. production/cloud force RDF_LLM_BACKEND=api.
RDF_DEPLOY_ENV=

# ---------- Job drops: social posts of new paid tasks (TDM-108; docs/MORNING.md "Job drops") ----------
# dry_run (default) writes the card + post text to RDF_DROP_DIR and posts NOTHING. live posts, and only to
# channels whose credentials below are set. Leave dry_run until you mean to post publicly.
RDF_DROP_MODE=
# Optional: max drops posted per hour across all channels (default 6); card folder (default ~/.local/state/rdf/job_drops)
RDF_DROP_MAX_PER_HOUR=
RDF_DROP_DIR=
# Optional: task types to drop (default clean_teleop,recovery_takeover,reset). Tag instructions [operator] to never drop one.
RDF_DROP_TYPES=
# Optional: 1 = print the demo-public access code on the card/post and pre-fill it on /join (anyone who sees the post can join)
RDF_DROP_SHOW_ACCESS_CODE=
# Optional: auto (reset start photo, else scene sketch) | sketch | none
RDF_DROP_FRAME=
# Discord (first channel). Bot: token from the Developer Portal (Bot tab) + the channel id (Developer Mode -> Copy Channel ID).
DISCORD_BOT_TOKEN=
RDF_DROP_DISCORD_CHANNEL_ID=
# Optional: only if the client id is not derivable from the token (scripts/discord-invite-url)
DISCORD_APPLICATION_ID=
# Alternative to the bot: a channel webhook URL (secret)
RDF_DROP_DISCORD_WEBHOOK=
# Bluesky: handle + an APP password (Settings -> Privacy and security -> App passwords), never the account password
RDF_DROP_BSKY_HANDLE=
RDF_DROP_BSKY_APP_PASSWORD=
# X (API v2 pay-per-use, OAuth 1.0a user context with Read and write): consumer key/secret + the posting account's access token/secret
RDF_DROP_X_API_KEY=
RDF_DROP_X_API_SECRET=
RDF_DROP_X_ACCESS_TOKEN=
RDF_DROP_X_ACCESS_SECRET=
# Optional: 1 = put the link in the post text (X bills a post with a URL $0.200 instead of $0.015)
RDF_DROP_X_INCLUDE_LINK=
# Telegram: bot token from @BotFather + the channel (@name or -100... id); add the bot to the channel as an admin
RDF_DROP_TELEGRAM_BOT_TOKEN=
RDF_DROP_TELEGRAM_CHAT_ID=

# ---------- Hybrid deploy (TDM-110: web on Vercel, backend here; docs/MORNING.md "Hybrid deploy") ----------
# Shared secret between Vercel's server routes and make demo-hybrid's edge (24+ chars). Same value on both
# sides; scripts/vercel/env-push.sh pushes it. Generate: openssl rand -base64 33 | tr '+/' '-_'
RDF_EDGE_SECRET=
# Optional: access code the Vercel site asks phones for once at /join (unset = open site)
RDF_WEB_ACCESS_CODE=
# Optional: orchestrator (or owner) SpacetimeDB token make demo-hybrid publishes orchestrator.endpoint with
# (default SPACETIME_TOKEN)
RDF_HYBRID_SPACETIME_TOKEN=
