# Copy to .env and fill in. .env is gitignored.
# Check what's set without printing values:  ./scripts/check-env.sh

# ---------- REQUIRED for overnight ----------
# Planner, reviewer, QA agents (Claude API)
ANTHROPIC_API_KEY=
# Factory Droid SDK (long-running agents)
FACTORY_API_KEY=
# Factory droid mode (TDM-30): local (default tonight; droid-sdk against this checkout) | cloud (Sessions API)
FACTORY_MODE=
# Cloud only: Factory Environment to create Droid Computers from (blank = 173ec531-f4f8-46e0-b246-6594c9590ea5)
FACTORY_ENVIRONMENT_ID=
# Cloud only, optional: reuse this Droid Computer instead of creating one
FACTORY_COMPUTER_ID=
# Optional: droid model (blank = gpt-5.4-mini) and reasoning effort (blank = low)
FACTORY_MODEL=
FACTORY_REASONING=
# Stripe TEST mode only (sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Hugging Face: LeRobot datasets, model downloads
HF_TOKEN=

# ---------- Modal ----------
# Local CLI is already logged in (~/.modal.toml). These are only needed for
# the deployed backend on Fly to launch Modal jobs.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---------- Optional ----------
# Training curves (openpi logs to W&B by default; leave blank to disable)
WANDB_API_KEY=
# Only if we use Stripe webhooks (from `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# Fly deploy (later)
FLY_API_TOKEN=
# Public tunnel for phones / Claude connector (blank = cloudflared quick tunnel)
NGROK_AUTHTOKEN=
# SpacetimeDB Maincloud (blank = local standalone server)
SPACETIME_TOKEN=

# ---------- Non-secret config ----------
SPACETIME_HOST=http://localhost:3000
SPACETIME_DB_NAME=robot-deploy-factory
JETSON_HOST=
JETSON_USER=

# ---------- Object storage (S3-compatible, episode media) ----------
# Loaded only by code that touches storage (StorageSettings / storageEnv).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- Service wiring (blank = default in code) ----------
# How the robot client, Factory and the web/MCP apps reach the orchestrator (default http://localhost:8000)
ORCHESTRATOR_URL=
# Robot this robot-client process drives (default yam-1)
ROBOT_ID=
# WebSocket port the Jetson robot-client listens on (default 8765)
JETSON_WS_PORT=

# ---------- Episode media store (TDM-4; see docs/decisions.md) ----------
# Backend: modal (default, Modal Volume behind services/media-store/) or s3 (Tigris/MinIO).
RDF_MEDIA_BACKEND=modal
# Public URL of the deployed services/media-store app (modal deploy prints it)
RDF_MEDIA_STORE_URL=https://jaxonp808--rdf-media.modal.run
# HMAC key shared with the Modal Secret `rdf-media-store`. Generate with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
RDF_MEDIA_SIGNING_KEY=
# Only for RDF_MEDIA_BACKEND=s3 (Tigris on Fly / local MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- Policy endpoint (TDM-37 / S-05b) ----------
# Base pi0.5 on Modal (app rdf-s05b-policy). POST {url}/infer or websocket {url}/ws.
# Scales to zero; warm it first: uv run --with modal python spikes/tdm-37-latency/warm.py up
POLICY_ENDPOINT_URL=https://jaxonp808--rdf-s05b-policy-policy-web.us-west.modal.run

# ---------- Policy server (TDM-41, production) ----------
# rdf-training app, class Policy: base pi0.5 + fine-tuned checkpoints, hot-swapped by URI.
# GET /health (public), POST /infer, websocket /ws, POST /policy/activate (Bearer POLICY_SERVER_TOKEN).
# Scales to zero: `make policy-up` before a robot session, `make policy-down` after.
POLICY_SERVER_URL=https://jaxonp808--rdf-training-policy-web.us-west.modal.run
# Shared bearer token; also synced into Modal Secret rdf-training by `make modal-secrets`.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POLICY_SERVER_TOKEN=

# ---------- Claude connector (apps/mcp, TDM-80) ----------
# Bearer token Claude / the MCP Inspector sends to POST /mcp (generate: openssl rand -hex 32)
MCP_TOKEN=
# Largest single approve_spend call through the connector, in cents (default 50000 = $500)
MCP_MAX_SPEND_CENTS=

# ---------- Policy rollout (TDM-50) ----------
# spike (default: POLICY_ENDPOINT_URL, no auth) | production (TDM-41: POLICY_SERVER_URL + POLICY_SERVER_TOKEN)
POLICY_BACKEND=

# ---------- Camera stream (TDM-55) ----------
# HMAC key shared by the orchestrator (mints /stream/token) and the Jetson stream server (generate: openssl rand -hex 32)
RDF_STREAM_TOKEN_SECRET=
# Optional: override the public stream URL the orchestrator hands out (else robot.camera_config_json.stream.url)
RDF_STREAM_URL=

# ---------- Robot page commands (TDM-78) ----------
# Shared key the web server adds to operator commands it forwards to the orchestrator
# (POST /robots/{id}/commands). Unset = every motion command from the page answers 503; the soft
# e-stop never needs it. Generate: uv run python spikes/tdm-78-robot-page/setup_web_auth.py operator-key
RDF_OPERATOR_KEY=
# `web` service identity token for the soft e-stop's direct path (web server -> SpacetimeDB). Unset =
# the e-stop goes through the orchestrator. Mint (writes to the DB): setup_web_auth.py mint-web-identity --yes
RDF_WEB_SPACETIME_TOKEN=

# ---------- Web push paging (TDM-65) ----------
# VAPID key pair (base64url: public = uncompressed P-256 point, private = raw 32-byte scalar).
# Generate once, locally; the orchestrator signs pushes, the browser gets the public key from GET /push/config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach (mailto: or https:)
VAPID_SUBJECT=
# Optional: where the orchestrator keeps push subscriptions (sqlite; default ~/.local/state/rdf/tdm65_push.sqlite3)
RDF_PUSH_STORE=
# Optional: public base URL of the web app for notification deep links (default: relative /marketplace?task=N)
RDF_WEB_PUBLIC_URL=
