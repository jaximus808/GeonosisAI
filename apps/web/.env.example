# Public (browser-visible) SpacetimeDB config for apps/web. Not secrets.
# Never put SPACETIME_TOKEN (the owner token) here or in any NEXT_PUBLIC_ var.
NEXT_PUBLIC_SPACETIME_HOST=https://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIME_DB_NAME=robo-factory-a706j
# TDM-60: base URL phones use for the /join QR code (LAN IP or tunnel; localhost won't work on a phone).
NEXT_PUBLIC_WEB_PUBLIC_URL=
# TDM-60: extra dev-server origins (comma-separated hostnames) allowed to load dev assets, e.g. *.ngrok-free.app
RDF_DEV_ORIGINS=
