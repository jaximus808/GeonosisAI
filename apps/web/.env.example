# Public (browser-visible) SpacetimeDB config for apps/web. Not secrets.
# Never put SPACETIME_TOKEN (the owner token) here or in any NEXT_PUBLIC_ var.
NEXT_PUBLIC_SPACETIME_HOST=https://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIME_DB_NAME=robo-factory-a706j
# TDM-60: base URL phones use for the /join QR code (LAN IP or tunnel; localhost won't work on a phone).
NEXT_PUBLIC_WEB_PUBLIC_URL=
# TDM-60: extra dev-server origins (comma-separated hostnames) allowed to load dev assets, e.g. *.ngrok-free.app
RDF_DEV_ORIGINS=
# Orchestrator base URL the BROWSER calls for GET routes (TDM-75 /media/sign, TDM-68 decision trail).
# Its CORS allows GET from http://localhost:3737 (add origins with RDF_WEB_ORIGINS on the orchestrator).
# Default http://localhost:8000; port 8000 is taken on the dev laptop, so set it, e.g. http://127.0.0.1:8001.
NEXT_PUBLIC_ORCHESTRATOR_URL=
# TDM-64 / TDM-79: orchestrator base URL the NEXT SERVER uses (the /api/tdm64 + /api/tdm79 proxies for
# PATCH/POST, and the server-rendered /tickets/[id]/report page). Falls back to NEXT_PUBLIC_ORCHESTRATOR_URL.
RDF_ORCHESTRATOR_URL=
