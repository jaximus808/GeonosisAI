# TDM-6: FAKE settings for CI and `make ci`. Nothing here is a real secret, and CI must never need one.
# scripts/ci/run.sh exports these and points RDF_ENV_FILE here, so settings loaders (rdf_common.settings,
# @rdf/env) never read the real repo .env. The SpacetimeDB host is a closed local port, so a test that
# forgets to mock the database fails fast instead of writing to maincloud.
# Live tests stay off: RDF_LIVE_CLAUDE etc. are unset (see run.sh).
ANTHROPIC_API_KEY=ci-fake-anthropic-key
FACTORY_API_KEY=ci-fake-factory-key
FACTORY_MODE=local
STRIPE_SECRET_KEY=sk_test_ci_fake
STRIPE_PUBLISHABLE_KEY=pk_test_ci_fake
STRIPE_WEBHOOK_SECRET=whsec_ci_fake
HF_TOKEN=ci-fake-hf-token
MODAL_TOKEN_ID=ak-ci-fake
MODAL_TOKEN_SECRET=as-ci-fake
SPACETIME_HOST=http://127.0.0.1:9
SPACETIME_DB_NAME=rdf-ci-fake
SPACETIME_TOKEN=ci-fake-spacetime-token
ROBOT_CLIENT_SPACETIME_TOKEN=ci-fake-robot-token
ORCHESTRATOR_URL=http://127.0.0.1:9
RDF_MEDIA_STORE_URL=http://127.0.0.1:9
RDF_MEDIA_SIGNING_KEY=ci-fake-media-signing-key
RDF_STREAM_TOKEN_SECRET=ci-fake-stream-token-secret
POLICY_ENDPOINT_URL=http://127.0.0.1:9
POLICY_SERVER_URL=http://127.0.0.1:9
POLICY_SERVER_TOKEN=ci-fake-policy-token
MCP_TOKEN=ci-fake-mcp-token
