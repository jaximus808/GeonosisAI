# TDM-118: Jetson-only, NON-SECRET settings for the northstar Jetson (docs/jetson-inventory.md).
# Pushed to ~/.config/geonosis/robot.local.env by scripts/jetson/tdm118_geonosis.sh install.
# Right YAM first: can_right (gs_usb 00280030594E501820313332); never can_left.
YAM_CAN_CHANNEL=can_right
YAM_ARM_TYPE=yam
YAM_GRIPPER=linear_4310
# YAM_GRIPPER_LIMITS=closed,open   # unknown until TDM-119's calibration; gripper reads 0.0 until then
YAM_KINEMATICS=auto
# refresh = DM refresh-status query (no enable/disable/command); listen = send nothing at all
TDM118_YAM_READ=refresh
TDM118_YAM_READ_HZ=20
# /ws/state through a cloudflared quick tunnel (the URL is announced in robot.camera_config_json.stream)
RDF_STREAM=cloudflared
RDF_STREAM_PORT=8091
CLOUDFLARED_BIN=/home/northstar/.local/bin/cloudflared
