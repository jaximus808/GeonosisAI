# TDM-119: Jetson-only, NON-SECRET settings for the real-arm steps and geonosis-robot-teleop.service.
# Pushed to ~/.config/geonosis/teleop.env by scripts/jetson/tdm118_geonosis.sh install. No inline comments.
# The user's sign-off copy of safety.yaml (tdm119_bringup sign-off writes it; until then the repo copy, unverified)
RDF_SAFETY_CONFIG=/home/northstar/.config/geonosis/safety.yaml
# SafetyLayer speed scale: 25 % of the yam profile's joint caps (0.8-1.2 rad/s) = 0.2-0.3 rad/s per joint
RDF_SAFETY_SPEED_SCALE=0.25
# teleop EE speed cap in m/s at the phone's speed_scale 1.0; the phone defaults to 0.5, so about 5 cm/s at start
RDF_TELEOP_MAX_LIN_SPEED=0.10
RDF_TELEOP_MAX_ANG_SPEED=0.5
# LarpSafeYamArm hard ceiling per joint (it can only go lower)
YAM_MAX_JOINT_SPEED=0.3
# Gripper: no stored limits exist, so the fork calibrates the linear_4310 at every connect, as vrteleop does at
# every start: the gripper alone opens and closes once at low torque while the arm holds (the fork aborts on arm
# drift). Keep fingers clear of the gripper while it enables. To skip it, set YAM_GRIPPER_LIMITS=closed,open
# from the values tdm119_bringup prints, and remove this line.
YAM_ALLOW_GRIPPER_CALIBRATION=1
# real-arm jobs tonight: teleop only (policy rollouts refused); 1 = allow run_baseline / run_eval
TDM119_ALLOW_POLICY=0
